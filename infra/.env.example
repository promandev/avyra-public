# =====================================================================
# Pradomotica — variables de entorno (ejemplo)
# Copia este archivo a `.env` y rellena los valores.
# NUNCA commitees el `.env` real.
# =====================================================================

# --- Postgres -------------------------------------------------------
POSTGRES_USER=pradomotica
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pradomotica
POSTGRES_PORT=5432

# --- Home Assistant -------------------------------------------------
# Crea un Long-Lived Access Token desde HA UI > Perfil > Tokens.
HA_BASE_URL=http://homeassistant:8123
HA_TOKEN=replace-with-long-lived-access-token

# --- App web (Next.js) ----------------------------------------------
APP_PORT=3000
# URL pública de la app (la que sirve Caddy / Tailscale).
APP_URL=https://pradomotica.local

# Conexión a Postgres desde la app
DATABASE_URL=postgres://pradomotica:change-me-strong-password@postgres:5432/pradomotica

# Auth.js — secreto de sesión. Generar con: `openssl rand -base64 48`
AUTH_SECRET=replace-with-48-byte-random-secret

# Clave maestra AES-256-GCM (32 bytes en base64). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Web Push (VAPID). Generar con: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=pradomotica.local
WEBAUTHN_RP_NAME=Pradomotica
WEBAUTHN_ORIGIN=https://pradomotica.local

# HMAC para webhooks entrantes desde Home Assistant
HA_WEBHOOK_SECRET=replace-with-random-hex

# Secreto HMAC para webhooks de movimiento de las cámaras YiHack.
# Generar con: openssl rand -hex 24
# Debe coincidir con el configurado en el script de la cámara.
CAMERA_WEBHOOK_SECRET=replace-with-random-hex

# --- Impresora ------------------------------------------------------
# URI IPP de la HP DeskJet 2600. Su IP sale en la hoja de configuración de red
# que se imprime con el botón (i). Reserva esa IP en el router (DHCP).
# Vacía => la sección Impresora aparece como "no configurada".
PRINTER_URI=ipp://192.168.1.XX/ipp/print

# --- Bóveda de contraseñas (Vaultwarden) ----------------------------
# URL pública de la bóveda. En el túnel de Cloudflare añade la Public Hostname
#   vault.tudominio.com → http://vaultwarden:80
# Vacía => la sección Bóveda aparece como "no configurada".
VAULT_PUBLIC_URL=https://vault.tudominio.com
# Sólo a true mientras creas tu cuenta; después, false y `docker compose up -d`.
VAULT_SIGNUPS_ALLOWED=false

# --- Cloudflare Tunnel (acceso remoto) ------------------------------
# Necesario solo si usas Cloudflare Tunnel para acceso externo.
# 1. Ve a https://one.dash.cloudflare.com → Networks → Tunnels → Create tunnel
# 2. Tipo: Cloudflared. Copia el token que genera.
# 3. En "Public Hostnames" del tunnel añade:
#      tu-subdominio.tudominio.com → http://app:3000
#      stream.tudominio.com        → http://go2rtc:1984   (para las cámaras)
# 4. Actualiza APP_URL y WEBAUTHN_ORIGIN/RP_ID con el dominio público.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Watchtower (auto-deploy) ----------------------------------------
# PAT de GitHub con scope "read:packages" para descargar la imagen privada.
# Crear en: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
GHCR_TOKEN=
